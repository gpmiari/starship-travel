{
  "name": "spaceship-race",
  "version": "1.0.0",
  "description": "Aplicação para calcular quantas paradas serão necessárias para percorrer uma dada distância, com cada uma das espaçonaves listadas em https://swapi.co/",
  "main": "index.js",
  "scripts": {
    "coverage": "NODE_ENV=test LOGGER_SILENT=1 c8 --reporter=text --reporter=lcov mocha",
    "mocha": "NODE_ENV=test mocha",
    "test": "npm run lint && npm run coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node index.js",
    "debug": "node --inspect-brk index.js",
    "debugtest": "NODE_ENV=test mocha --inspect-brk"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpmiari/spaceship-race.git"
  },
  "keywords": [
    "spaceship",
    "nodejs"
  ],
  "author": "Guilherme Miari",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/gpmiari/spaceship-race/issues"
  },
  "homepage": "https://github.com/gpmiari/spaceship-race#readme",
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "morgan": "^1.12.1",
    "tv4": "^1.3.0",
    "winston": "^3.19.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "chance": "^1.1.13",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "nock": "^15.0.6",
    "sinon": "^22.1.0",
    "supertest": "^7.3.2"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  }
}
